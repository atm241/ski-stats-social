// Postgres everywhere (local: `docker compose up -d`). The connection URL lives in prisma.config.ts.
// Schema changes go through migrations: `npm run db:migrate -- --name <change>`.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  /// Sign-in identity. Null only for seeded demo users.
  email       String?  @unique
  /// Secret local part of the user's upload address: <uploadToken>@INBOUND_DOMAIN
  uploadToken String?  @unique
  username    String   @unique
  displayName String
  /// Emoji shown in the user's avatar bubble.
  avatar      String
  /// Avatar background, one of the palette keys in src/lib/avatars.ts.
  color       String
  /// Opted in to the public "Everyone" leaderboard. Off by default: friends see your stats either way.
  globalBoard Boolean  @default(false)
  /// Secret code in the user's invite link (/invite/<code>); opening it lets someone add them as a friend.
  inviteCode  String?  @unique
  createdAt   DateTime @default(now())
  days        SkiDay[]
  sessions    Session[]
  uploads     Upload[]
  following   Follow[] @relation("follower")
  followers   Follow[] @relation("following")
  apiTokens   ApiToken[]
  comments    Comment[]
  runs        Run[]
  liftRides   LiftRide[]
  runLikes    RunLike[]
}

/// Personal access token for the iPhone sync app (Bearer auth on /api/uploads). Only the hash is stored.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

/// One-way follow (like Strava): following someone puts their days in your feed and friends board.
model Follow {
  followerId  String
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId])
}

/// Database session; the cookie holds a random token, only its SHA-256 is stored.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

/// One-time sign-in link. Only the token's SHA-256 is stored.
model LoginToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([email, createdAt])
}

/// Every file that came in (web upload or email), so people can see what happened to it.
model Upload {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "web" | "email"
  source    String
  fileName  String
  /// "imported" | "duplicate" | "skipped" | "error"
  status    String
  /// Human-readable result, e.g. "Vail · +21,300 ft" or the error message
  message   String
  /// JSON: ids of SkiDays created from this file
  dayIds    String   @default("[]")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model SkiDay {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Calendar date where the skiing happened, YYYY-MM-DD.
  localDate     String
  /// e.g. "2025-26", see src/lib/season.ts
  seasonKey     String
  timezone      String
  startedAt     DateTime
  endedAt       DateTime
  /// "resort" | "backcountry" | "mixed"
  kind          String
  resortId      String?
  resortName    String?
  resortCountry String?
  verticalM     Float
  uphillM       Float
  distanceM     Float
  maxSpeedMps   Float
  runCount      Int
  liftCount     Int
  skiTimeS      Int      @default(0)
  liftTimeS     Int      @default(0)
  liftWaitS     Int      @default(0)
  skinTimeS     Int      @default(0)
  driveTimeS    Int      @default(0)
  longestRunM   Float    @default(0)
  tallestRunM   Float    @default(0)
  peakEleM      Float    @default(0)
  /// Flagged days are kept but excluded from leaderboards.
  flagged       Boolean  @default(false)
  flagReasons   String?
  /// "gpx" today; later "strava", "healthkit", ...
  source        String
  fileName      String?
  /// JSON: StoredTrack (downsampled points) — see src/lib/analysis/process.ts
  track         String
  /// JSON: Segment[]
  segments      String
  createdAt     DateTime @default(now())
  comments      Comment[]
  runs          Run[]
  liftRides     LiftRide[]

  @@unique([userId, startedAt])
  @@index([seasonKey, flagged])
  @@index([userId, localDate])
  @@index([resortName, localDate])
}

/// A comment on someone's ski day.
model Comment {
  id        String   @id @default(cuid())
  dayId     String
  day       SkiDay   @relation(fields: [dayId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([dayId, createdAt])
}

/// One run (downhill segment) of a saved day at a mountain we have a trail map for, named when the day
/// is saved, so per-trail leaderboards ("fastest down McConkey's") are plain queries.
model Run {
  id          String    @id @default(cuid())
  dayId       String
  day         SkiDay    @relation(fields: [dayId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// segment index within the day
  index       Int
  /// 3D mountain slug, e.g. "park-city"
  mountain    String
  /// the trail most of the run was on
  trail       String
  /// JSON: every trail along the way, in order, e.g. ["Georgeanna","McConkey's Bowl"]
  trails      String
  difficulty  String?
  startedAt   DateTime
  durationS   Float
  verticalM   Float
  maxSpeedMps Float
  /// copied from the day: flagged days stay off speed boards
  flagged     Boolean   @default(false)
  likeCount   Int       @default(0)
  likes       RunLike[]
  /// one row per trail the run went down, with the top speed while on it
  onTrails    RunTrail[]

  @@unique([dayId, index])
  @@index([userId])
  @@index([mountain, trail])
  @@index([mountain, likeCount])
}

model RunLike {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  runId     String
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, runId])
  @@index([runId])
}

/// A trail a run went down, with the top speed on that stretch: "fastest down McConkey's Bowl" means
/// fastest while on McConkey's, not on the runout below it.
model RunTrail {
  runId       String
  run         Run     @relation(fields: [runId], references: [id], onDelete: Cascade)
  mountain    String
  trail       String
  maxSpeedMps Float
  /// share of the run's points on this trail
  share       Float
  userId      String
  flagged     Boolean @default(false)

  @@id([runId, trail])
  @@index([mountain, trail, maxSpeedMps])
  @@index([userId, mountain])
}

/// A named lift ride, indexed with a day's runs so profile and mountain pages can count rides
/// without re-reading GPS tracks.
model LiftRide {
  id        String   @id @default(cuid())
  dayId     String
  day       SkiDay   @relation(fields: [dayId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// segment index within the day
  index     Int
  mountain  String
  lift      String
  startedAt DateTime
  flagged   Boolean  @default(false)

  @@unique([dayId, index])
  @@index([userId])
  @@index([mountain, lift])
}

/// Fixed-window request counters, shared by every server instance.
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int
}

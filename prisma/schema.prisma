// SQLite for local development. To deploy, switch provider to "postgresql" and point
// DATABASE_URL at a hosted Postgres (Neon, Supabase, RDS...).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  /// Sign-in identity. Null only for seeded demo users.
  email       String?  @unique
  /// Secret local part of the user's upload address: <uploadToken>@INBOUND_DOMAIN
  uploadToken String?  @unique
  username    String   @unique
  displayName String
  /// Emoji shown in the user's avatar bubble.
  avatar      String
  /// Avatar background, one of the palette keys in src/lib/avatars.ts.
  color       String
  createdAt   DateTime @default(now())
  days        SkiDay[]
  sessions    Session[]
  uploads     Upload[]
}

/// Database session; the cookie holds a random token, only its SHA-256 is stored.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

/// One-time sign-in link. Only the token's SHA-256 is stored.
model LoginToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([email, createdAt])
}

/// Every file that came in (web upload or email), so people can see what happened to it.
model Upload {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "web" | "email"
  source    String
  fileName  String
  /// "imported" | "duplicate" | "skipped" | "error"
  status    String
  /// Human-readable result, e.g. "Vail · +21,300 ft" or the error message
  message   String
  /// JSON: ids of SkiDays created from this file
  dayIds    String   @default("[]")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model SkiDay {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Calendar date where the skiing happened, YYYY-MM-DD.
  localDate     String
  /// e.g. "2025-26", see src/lib/season.ts
  seasonKey     String
  timezone      String
  startedAt     DateTime
  endedAt       DateTime
  /// "resort" | "backcountry" | "mixed"
  kind          String
  resortId      String?
  resortName    String?
  resortCountry String?
  verticalM     Float
  uphillM       Float
  distanceM     Float
  maxSpeedMps   Float
  runCount      Int
  liftCount     Int
  skiTimeS      Int      @default(0)
  liftTimeS     Int      @default(0)
  liftWaitS     Int      @default(0)
  skinTimeS     Int      @default(0)
  driveTimeS    Int      @default(0)
  longestRunM   Float    @default(0)
  tallestRunM   Float    @default(0)
  peakEleM      Float    @default(0)
  /// Flagged days are kept but excluded from leaderboards.
  flagged       Boolean  @default(false)
  flagReasons   String?
  /// "gpx" today; later "strava", "healthkit", ...
  source        String
  fileName      String?
  /// JSON: StoredTrack (downsampled points) — see src/lib/analysis/process.ts
  track         String
  /// JSON: Segment[]
  segments      String
  createdAt     DateTime @default(now())

  @@unique([userId, startedAt])
  @@index([seasonKey, flagged])
  @@index([userId, localDate])
}

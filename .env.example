DATABASE_URL="file:./dev.db"

# Public URL of the app, used in sign-in links and emails
APP_URL="http://localhost:3000"

# Outgoing email (sign-in links, import receipts). Without a key, emails print to the server console.
# RESEND_API_KEY=""
# EMAIL_FROM="Pow Pals <hello@yourdomain.com>"

# Email-to-upload: users get <token>@INBOUND_DOMAIN. Point that domain's MX at Postmark inbound and set the
# Postmark webhook to https://inbound:<INBOUND_WEBHOOK_SECRET>@<APP_URL host>/api/inbound/postmark
INBOUND_DOMAIN="upload.localhost"
INBOUND_WEBHOOK_SECRET="change-me"

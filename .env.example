# Postgres: `npm run db:up` starts one in Docker on port 5434 (tests use the gapr_test database next to it)
DATABASE_URL="postgresql://gapr:gapr@localhost:5434/gapr"

# Public URL of the app, used in sign-in links and emails
APP_URL="http://localhost:3100"

# Outgoing email (sign-in links, import receipts). Without a key, emails print to the server console.
# RESEND_API_KEY=""
# EMAIL_FROM="Gapr <hello@yourdomain.com>"

# Email-to-upload: users get <token>@INBOUND_DOMAIN. Point that domain's MX at Postmark inbound and set the
# Postmark webhook to https://inbound:<INBOUND_WEBHOOK_SECRET>@<APP_URL host>/api/inbound/postmark
INBOUND_DOMAIN="upload.localhost"
INBOUND_WEBHOOK_SECRET="change-me"

# Where the built 3D mountain files are served from. Unset: public/mountains. In production, point this
# at a CDN or bucket holding the same files (absolute URL, no trailing slash).
# NEXT_PUBLIC_MOUNTAINS_URL="https://cdn.example.com/mountains"
